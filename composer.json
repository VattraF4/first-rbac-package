{
  "name": "vattra/laravel-rbac",
  "vattra/laravel-rbac": "dev-main",
  "description": "Fast, config-driven role-based access control for Laravel",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "rbac",
    "roles",
    "permissions",
    "auth"
  ],
  "authors": [
    {
      "name": "Ra Vattra",
      "email": "vattraramo13@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Vattra\\Rbac\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Vattra\\Rbac\\RbacServiceProvider"
      ],
      "aliases": {
        "Rbac": "Vattra\\Rbac\\Facades\\Rbac"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
