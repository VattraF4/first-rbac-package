{
    "name": "vattra/laravel-rbac",
    "description": "Fast, config-driven role-based access control for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "rbac", "roles", "permissions", "auth"],
    "authors": [
        {
            "name": "Ra Vattra",
            "email": "vattraramo13@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Vattra\\Rbac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vattra\\Rbac\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vattra\\Rbac\\RbacServiceProvider"
            ],
            "aliases": {
                "Rbac": "Vattra\\Rbac\\Facades\\Rbac"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
